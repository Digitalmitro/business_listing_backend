# Application Environment Configuration Example
PORT=8000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
MONGO_URI=mongodb://localhost:27017/businessListing
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_OTP=true
ENCRYPTION_KEY=replace_with_at_least_32_random_characters
# LinkedIn Integration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/social-integrations/callback/linkedin
LINKEDIN_API_VERSION=202601

# Meta (Facebook, Instagram, Threads) Integrations
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/social-integrations/callback/facebook

INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/social-integrations/callback/instagram

THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret
THREADS_REDIRECT_URI=http://localhost:8000/api/social-integrations/callback/threads

# Twitter / X Integration
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=http://localhost:8000/api/social-integrations/callback/twitter

# Pinterest Integration
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=your_pinterest_app_secret
PINTEREST_REDIRECT_URI=http://localhost:8000/api/social-integrations/callback/pinterest

# Google Business Profile Integration
GOOGLE_BUSINESS_CLIENT_ID=your_google_business_client_id
GOOGLE_BUSINESS_CLIENT_SECRET=your_google_business_client_secret
GOOGLE_BUSINESS_REDIRECT_URI=http://localhost:8000/api/google-business/callback

# Redis & BullMQ Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_BACKOFF_TYPE=exponential
BULLMQ_BACKOFF_DELAY=5000

# CRM Follow-Up Automation Configuration
CRM_FOLLOW_UP_INTERVAL_MINUTES=60
IMPORT_FILE_SIZE_LIMIT=10485760

# Security & Webhooks
WEBHOOK_SECRET=your_hmac_webhook_secret_here

# Cloudinary Storage
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=your_bucket_name
AWS_REGION=eu-north-1

# Email Service (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Google Sign-In for portal authentication only. Tenant Google Business Profile
# credentials are configured through the tenant integrations settings API.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Payment Gateways
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Geocoding Services
LOCATIONIQ_API_KEY=your_locationiq_key
MAPBOX_ACCESS_TOKEN=your_mapbox_token
GEOCODING_PROVIDER=mapbox
