# Application Environment Configuration Example
PORT=8000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
MONGO_URI=mongodb://localhost:27017/businessListing
FRONTEND_URL=http://localhost:5173

# Redis & BullMQ Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_BACKOFF_TYPE=exponential
BULLMQ_BACKOFF_DELAY=5000

# CRM Follow-Up Automation Configuration
CRM_FOLLOW_UP_INTERVAL_MINUTES=60
IMPORT_FILE_SIZE_LIMIT=10485760

# Security & Webhooks
WEBHOOK_SECRET=your_hmac_webhook_secret_here

# Cloudinary Storage
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=your_bucket_name
AWS_REGION=eu-north-1

# Email Service (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Google OAuth (required for Google My Business Profile integration)
# Obtain from: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match EXACTLY the Authorized Redirect URI registered in Google Cloud Console.
# Development:  http://localhost:8000/api/google-business/callback
# Production:   https://yourdomain.com/api/google-business/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google-business/callback

# Social Integration APIs
INSTAGRAM_GRAPH_API_VERSION=v19.0

# Payment Gateways
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Geocoding Services
LOCATIONIQ_API_KEY=your_locationiq_key
MAPBOX_ACCESS_TOKEN=your_mapbox_token
GEOCODING_PROVIDER=mapbox
