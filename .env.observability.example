# Logging and request correlation
LOG_LEVEL=info
LOG_FORMAT=json
SLOW_REQUEST_MS=2000
TRUST_PROXY=true

# Periodic process telemetry
RESOURCE_LOG_INTERVAL_MS=60000
MEMORY_WARNING_MB=768
HEAP_WARNING_PERCENT=85
EVENT_LOOP_WARNING_MS=200

# MongoDB diagnostics (command contents are never logged)
MONGO_COMMAND_MONITORING=true
MONGO_SLOW_QUERY_MS=500
MONGO_LOG_ALL_COMMANDS=false
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Crash/shutdown policy
EXIT_ON_UNHANDLED_REJECTION=true
SHUTDOWN_TIMEOUT_MS=10000
CRASH_SHUTDOWN_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_HEADERS_TIMEOUT_MS=65000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

# PM2.io telemetry; tracing is intentionally opt-in because it adds overhead
PM2_NOTIFY_ERRORS=true
PM2_NETWORK_METRICS=false
PM2_TRANSACTION_TRACING=false
PM2_TRACE_SAMPLING_RATE=10

# PM2 cluster and memory policy (read by ecosystem.config.js)
WEB_CONCURRENCY=2
API_MAX_MEMORY=1G
WORKER_MAX_MEMORY=768M

# Whole-machine CPU monitor
CPU_MONITOR_INTERVAL_MS=60000
CPU_TRACKING_THRESHOLD=60
CPU_WARNING_THRESHOLD=70
CPU_SUSTAINED_WARNING_MS=300000
CPU_RESTART_THRESHOLD=75
CPU_RESTART_COOLDOWN_MS=900000
PM2_RESTART_TIMEOUT_MS=30000
