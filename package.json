    "@reduxjs/toolkit": "^2.3.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "bson": "^6.10.1",
    "bullmq": "^5.61.2",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
