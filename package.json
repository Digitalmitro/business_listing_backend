{
  "name": "business_listing_backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "node --test scripts/*.test.js utils/*.test.js middlewares/*.test.js",
    "test:cpu-monitor": "node --test scripts/cpuMonitor.test.js",
    "test:observability": "node --test utils/*.test.js middlewares/*.test.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "monitor:cpu": "node scripts/cpuMonitor.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:deploy": "pm2 startOrReload ecosystem.config.js --env production --update-env",
    "pm2:reload": "pm2 reload business-listing-api --update-env",
    "pm2:restart": "pm2 restart business-listing-api --update-env",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs business-listing-api --lines 200",
    "pm2:save": "pm2 save",
    "pm2:setup-logs": "pm2 install pm2-logrotate && pm2 set pm2-logrotate:max_size 20M && pm2 set pm2-logrotate:retain 14 && pm2 set pm2-logrotate:compress true && pm2 set pm2-logrotate:rotateInterval '0 0 * * *'"
  },
